# Copia este archivo a .env.local y rellena los valores de tu proyecto de Supabase.
# Ambos valores son públicos por diseño (la seguridad la da RLS en la base de datos).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: enlace de descarga del APK para activar el botón de la portada.
# NEXT_PUBLIC_APK_URL=
